{
  "name": "openmeido",
  "version": "0.0.34",
  "description": "Productivity assistant + Live2D companion for non-programmers",
  "author": "lsh <laishaoheng1996@gmail.com>",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "chcp 65001 >nul && electron-vite dev",
    "dev:fake-mail": "node scripts/dev-fake-mail.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "spike1": "node --env-file=.env --import tsx tools/spike1.ts",
    "test:leak-audit": "node tools/smoke-live2d-leak-audit.mjs",
    "test:reflection-parse": "node --import tsx tools/smoke-reflection-parse.mjs",
    "test:openai-compat-body": "node --import tsx tools/smoke-openai-compat-body.mjs",
    "test:mime-snippet": "node --import tsx tools/smoke-mime-snippet.mjs",
    "test:memory-negation-e2e": "electron tools/smoke-memory-negation-e2e.mjs",
    "test:notif-parse": "node --import tsx tools/smoke-notif-parse.mjs",
    "test:text-filter": "node --import tsx tools/smoke-text-filter.mjs",
    "test:task-adapter": "electron tools/smoke-task-adapter.mjs",
    "test:naive-memory": "electron tools/smoke-naive-memory.mjs",
    "test:task-agent": "node --env-file=.env --import tsx tools/smoke-task-agent.mjs",
    "test:docx-parse": "node --import tsx tools/smoke-docx-parse.mjs",
    "test:apikey-roundtrip": "node --import tsx tools/smoke-apikey-roundtrip.mjs",
    "experiment:glm-id": "node --env-file=.env --import tsx tools/experiment-glm-id.mjs",
    "test:search-agent": "node --env-file=.env --import tsx tools/smoke-search-agent.mjs",
    "test:emotion-classifier": "node --env-file=.env --import tsx tools/smoke-emotion-classifier.mjs",
    "test:emotion-pipeline": "node --import tsx tools/smoke-emotion-pipeline.mjs",
    "test:affinity-guardrails": "node --import tsx tools/smoke-affinity-guardrails.mjs",
    "test:combined-classifier": "node --env-file=.env --import tsx tools/smoke-combined-classifier.mjs",
    "test:baked-emotion": "node --env-file=.env --import tsx tools/smoke-baked-emotion.mjs",
    "test:table-window": "electron tools/smoke-table-window.mjs",
    "test:table-multitab": "electron tools/smoke-table-multitab.mjs",
    "test:list-inbox": "electron tools/smoke-list-inbox.mjs",
    "test:table-e2e": "electron tools/smoke-table-e2e.mjs",
    "test:tier-conversation": "node --env-file=.env --import tsx tools/smoke-tier-conversation.mjs",
    "test:elaborate": "node --env-file=.env --import tsx tools/smoke-elaborate-proactive.mjs",
    "test:email-draft": "node --env-file=.env --import tsx tools/smoke-email-draft.mjs",
    "test:email-draft-routing": "node --env-file=.env --import tsx tools/smoke-email-draft-routing.mjs",
    "test:presence-gate": "node --import tsx tools/smoke-presence-gate.mjs",
    "test:quick-screen-now": "electron tools/test-quick-screen-now.mjs",
    "inspect:memory": "node tools/inspect-memory.mjs",
    "test:persona-isolation": "electron tools/smoke-persona-isolation.mjs",
    "test:stt-sovits": "electron tools/smoke-stt-sovits.mjs",
    "test:mail-parent": "node --import tsx tools/smoke-mail-parent.mjs",
    "test:fake-mail": "node --import tsx tools/smoke-fake-mail.mjs",
    "test:tts-minimax-body": "node tools/smoke-tts-minimax-body.mjs",
    "test:tts-volcengine-body": "node tools/smoke-tts-volcengine-body.mjs",
    "test:fake-mail-agent": "node --env-file=.env --import tsx tools/smoke-fake-mail-agent.mjs",
    "ensure-embed-model": "node scripts/ensure-embed-model.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.75",
    "@ai-sdk/openai": "^3.0.64",
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "@pixi/core": "^7.4.3",
    "@pixi/display": "^7.4.3",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.5.17",
    "ai": "^6.0.184",
    "better-sqlite3": "^12.10.0",
    "electron-store": "^11.0.2",
    "imapflow": "^1.3.3",
    "linkedom": "^0.18.12",
    "mailparser": "^3.9.8",
    "mammoth": "^1.12.0",
    "msedge-tts": "^2.0.5",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.0"
  }
}
