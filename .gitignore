node_modules
dist
out
# build/* (NOT bare `build`) so the !build/icon.png negation works —
# git can't re-include files inside a fully-ignored directory. With
# build/* we ignore contents but the dir itself stays traversable.
# electron-builder reads its buildResources from build/, and the app
# icon must ship with the repo so cloners get the right .exe icon.
build/*
!build/icon.png
# icon/ is my working directory for icon source files (full-res PNGs
# before resize) — not needed for build, kept out of git to avoid bloat.
icon/
*.log
*.tsbuildinfo
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
.env
.env.local

# Live2D models with restrictive licenses — keep out of git history.
# Only models with explicit redistribution rights (e.g. Live2D official
# samples under the Free Material License v1.6) should be tracked.
src/renderer/public/live2d-models/haitu_vts/

# Cubism source files — only `runtime/` is needed at runtime, the PSDs
# (Photoshop layered art) and the .cmo3 / .can3 (Cubism Editor project
# files) are huge binaries that bloat the repo without helping anyone
# who only wants to run the app.
*.psd
*.cmo3
*.can3

# Raw model files — kept locally for re-extraction / bundling into
# installers. Not source code, so not in git. The bge-small-zh-v1.5 ONNX
# model under models/Xenova/ is downloaded by scripts/ensure-embed-model.mjs
# (which `npm run dist` runs as a pre-step). Live2D zips at models/*.zip
# are extracted into src/renderer/public/live2d-models/ by the seed flow.
models/

# Project-root background/ is author-only working storage. The actual
# assets shipped with the renderer live at src/renderer/public/background/.
/background/

# Claude Code workspace metadata + local release-notes scratch.
.claude/
dist-build/
